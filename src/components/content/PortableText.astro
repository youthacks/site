---
import { PortableText as BasePortableText } from "astro-portabletext";
import type { PortableTextProps } from "astro-portabletext/types";
import Link from "./Link.astro";
import InternalLink from "./InternalLink.astro";
import type { HTMLAttributes } from "astro/types";
import SponsorGrid from "./SponsorGrid.astro";

export type Color = "red" | "yellow" | "blue" | "grey" | "white";

interface Props extends HTMLAttributes<"div"> {
  value: PortableTextProps["value"];
  color?: Color;
}
const { value, color, ...props } = Astro.props;
---

<div {...props} data-content>
  <BasePortableText
    value={value}
    components={{
      mark: {
        link: Link,
        internalLink: InternalLink,
      },
      type: {
        sponsorGridBlock: SponsorGrid,
      },
    }}
  >
    <fragment slot="mark"
      >{
        ({ Component, props, children }: any) => (
          <Component {...props} color={color}>
            {children}
          </Component>
        )
      }</fragment
    >
  </BasePortableText>
</div>

<style is:global>
  @reference "../../styles/global.css";
  [data-content] {
    h2 {
      @apply font-heading mt-8 text-3xl font-bold;
    }
    p {
      @apply max-w-4xl leading-normal;
    }
  }
</style>
