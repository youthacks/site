---
import { sanityClient } from "sanity:client";
import { LAYOUT_QUERY } from "~/queries";
import SanityImage from "./SanityImage.astro";
import resolveInternalLink from "~/lib/internalLink";

const result = await sanityClient.fetch(LAYOUT_QUERY);

const links = await Promise.all(
  (result?.navbar?.links || []).map(async (link) => {
    const href = await resolveInternalLink(link.link);
    return {
      ...link,
      href,
    };
  }),
);
---

<header id="header" class="group fixed inset-x-0 top-0 isolate z-20">
  <div
    class="absolute inset-0 -z-10 h-0 bg-white transition-[height,box-shadow] group-data-open:h-full group-data-open:shadow-lg"
  >
  </div>
  <div
    class="mx-auto flex h-20 max-w-7xl items-center px-12 transition-[height]"
  >
    {
      result?.navbar?.logo && (
        <a href="/">
          <SanityImage src={result.navbar.logo} class="h-8" />
        </a>
      )
    }
    <div class="flex-1"></div>
    <nav class="flex items-center gap-3">
      {
        links.map((link, idx) => (
          <>
            {idx > 0 && <span class="text-current/50">/</span>}
            <a
              href={link.href}
              class="text-lg font-semibold underline-offset-2 hover:underline"
            >
              {link.label}
            </a>
          </>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .clip-header {
    clip-path: inset(0 0 100% 0);

    #header[data-open] & {
      clip-path: inset(0 0 0 0);
    }
  }
</style>

<script>
  function onScroll() {
    const header = document.getElementById("header");
    if (!header) return;

    if (window.scrollY > 32) {
      header.dataset.open = "true";
    } else {
      delete header.dataset.open;
    }
  }

  window.addEventListener("scroll", onScroll);
  onScroll();
</script>
