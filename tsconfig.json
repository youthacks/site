{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "./worker-configuration.d.ts"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "sanity.types": [
        "./sanity.types.ts"
      ],
      "node_modules/*": [
        "./node_modules/*"
      ]
    },
    "types": [
      "@sanity/astro/module"
    ]
  }
}