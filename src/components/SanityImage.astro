---
import type {
  ImageUrlBuilderOptionsWithAliases,
  SanityImageSource,
} from "@sanity/image-url";
import type { HTMLAttributes } from "astro/types";
import imageBuilder from "~/lib/imageBuilder";

interface Props extends Omit<HTMLAttributes<"img">, "src"> {
  src: SanityImageSource;
  priority?: boolean;
  widths?: number[];
  opts?: ImageUrlBuilderOptionsWithAliases;
}
const { src, priority = false, widths, opts = {}, ...props } = Astro.props;

const image = imageBuilder.image(src).withOptions({
  quality: 80,
  ...opts,
});
---

<img
  {...props}
  src={image.url()}
  {...widths && {
    srcset: widths.map((w) => `${image.width(w).url()} ${w}w`).join(", "),
  }}
  {...priority
    ? { fetchpriority: "high", loading: "eager" }
    : { loading: "lazy", decoding: "async" }}
/>
