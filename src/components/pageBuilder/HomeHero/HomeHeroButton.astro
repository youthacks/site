---
import type { HomeHero } from "sanity.types";
import resolveInternalLink from "~/lib/internalLink";

interface Props {
  data: NonNullable<HomeHero["buttons"]>[number];
}
const { data } = Astro.props;
---

<a
  href={await resolveInternalLink(data.link)}
  class:list={[
    "flex h-12 items-center rounded-full px-6 text-lg font-semibold text-white",
    data.isPrimary
      ? "bg-red-800 shadow-sm transition hover:bg-red-900"
      : "border border-white/50 transition hover:bg-white/10",
  ]}
>
  {data.label} →
</a>
