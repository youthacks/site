---
import type { Content } from "sanity.types";
import PortableText from "~/components/content/PortableText.astro";

interface Props {
  data: Content;
}
const { data } = Astro.props;
---

<div class="mx-auto max-w-7xl p-8" data-transparent>
  <PortableText
    value={data.content || []}
    color={data.color}
    class="max-w-4xl space-y-4 text-xl text-neutral-900"
  />
</div>
