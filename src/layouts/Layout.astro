---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import { sanityClient } from "sanity:client";
import { LAYOUT_QUERY } from "~/queries";

import "../styles/global.css";
import Footer from "~/components/Footer.astro";

interface Props {
  pageTitle?: string;
  description?: string;
}
const { pageTitle, description } = Astro.props;

const result = await sanityClient.fetch(LAYOUT_QUERY);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>
      {pageTitle ? `${pageTitle} - ${result?.siteName}` : result?.siteName}
    </title>
    <meta
      name="description"
      content={description ||
        "We support and run hackathons and coding events for teens in the UK, and create safe spaces where young coders can learn and thrive, together."}
    />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-serif" />
    <Font cssVariable="--font-cursive" />

    <ClientRouter />

    <script
      is:inline
      src="https://analytics.ahrefs.com/analytics.js"
      data-key="To6byBCl2h9X7SYhdwJCiA"
      async></script>
  </head>
  <body>
    <slot />

    {result?.footer && <Footer data={result.footer} />}
  </body>
</html>
