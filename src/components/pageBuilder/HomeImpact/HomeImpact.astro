---
import type { HomeImpact } from "sanity.types";

interface Props {
  data: HomeImpact;
}
const { data } = Astro.props;

const bgColor = {
  red: "bg-red-200",
  yellow: "bg-yellow-200",
  blue: "bg-cyan-200",
  grey: "bg-neutral-100",
}[data.color || "red"];

const textColor = {
  red: "text-red-800",
  yellow: "text-yellow-800",
  blue: "text-cyan-800",
  grey: "text-neutral-600",
}[data.color || "red"];

const pillColor = ["text-red-800", "text-yellow-800", "text-cyan-800"];
---

<div class={bgColor}>
  <div class="mx-auto max-w-7xl p-8">
    <div class="flex items-center gap-3">
      <div class:list={["size-7 rounded-full bg-current", textColor]}></div>
      <h2 class="font-heading text-4xl font-bold">{data.title}</h2>
    </div>
    <div class="mt-6 grid grid-cols-1 gap-4 lg:grid-cols-3">
      {
        (data.statistics || []).slice(0, 3).map((stat, idx) => (
          <div
            class:list={[
              "rounded-full border border-current bg-white/20 p-6 py-8 text-center shadow-sm",
              pillColor[idx],
            ]}
          >
            <p class="font-heading text-5xl font-bold">{stat.number}</p>
            <p class="mt-1 text-xl text-black">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>
