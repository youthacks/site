---
import type { HomeHero } from "sanity.types";
import { PortableText } from "astro-portabletext";
import SanityImage from "~/components/SanityImage.astro";
import HomeHeroTitle from "./HomeHeroTitle.svelte";
import HomeHeroButton from "./HomeHeroButton.astro";

import { Image } from "astro:assets";
import Background from "~/assets/images/hero-bg.svg";
import Scribble from "~/assets/images/hero-scribble.svg";

interface Props {
  data: HomeHero;
}
const { data } = Astro.props;
---

<div class="relative isolate">
  <div class="absolute inset-0 -z-10 mb-12 overflow-x-clip">
    <Background
      data-part="background"
      class="size-full"
      preserveAspectRatio="xMidYMid slice"
    />
    <div class="absolute inset-0 bg-noise"></div>
    <div class="absolute inset-0 mx-auto max-w-7xl overflow-y-clip">
      <Scribble
        data-part="scribble"
        class="absolute -top-26 -right-34 opacity-50"
      />
    </div>
  </div>
  <div
    class:list={["mx-auto max-w-7xl p-8 pt-32! md:p-12", data.image && "pb-0!"]}
  >
    <div data-part="heading">
      <HomeHeroTitle client:idle />
    </div>
    {
      data.description && (
        <div
          data-part="paragraph"
          class="mt-4 max-w-4xl text-lg leading-snug text-pretty sm:text-balance md:text-xl"
        >
          <PortableText value={data.description || []} />
        </div>
      )
    }
    {
      data.buttons && (
        <div data-part="buttons" class="mt-4 flex flex-wrap gap-4">
          {data.buttons.map((button) => (
            <HomeHeroButton data={button} />
          ))}
        </div>
      )
    }

    {
      data.image && (
        <figure
          data-part="figure"
          class="-mx-2 mt-12 -rotate-1 space-y-4 bg-white p-4 shadow-md"
        >
          <SanityImage
            src={data.image}
            width={1280}
            layout="constrained"
            class="aspect-3/2 max-h-96 w-full object-cover"
            priority
          />
          <figcaption class="text-center font-serif leading-tight italic">
            {data.image.caption}
          </figcaption>
        </figure>
      )
    }
  </div>
</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    [data-part="background"] {
      animation: background 500ms ease both;
    }
    @keyframes background {
      0% {
        opacity: 0;
      }
      100% {
        opacity: 1;
      }
    }

    [data-part="heading"] {
      animation: heading 1s cubic-bezier(0.16, 1, 0.3, 1) 200ms both;
    }
    @keyframes heading {
      0% {
        translate: 0 24px;
        opacity: 0;
      }
      100% {
        translate: 0 0;
        opacity: 1;
      }
    }

    [data-part="paragraph"] {
      animation: paragraph 1s cubic-bezier(0.16, 1, 0.3, 1) 400ms both;
    }
    [data-part="buttons"] {
      animation: paragraph 1s cubic-bezier(0.16, 1, 0.3, 1) 500ms both;
    }
    @keyframes paragraph {
      0% {
        translate: 0 16px;
        opacity: 0;
      }
      100% {
        translate: 0 0;
        opacity: 1;
      }
    }

    [data-part="figure"] {
      animation: figure 1s cubic-bezier(0.16, 1, 0.3, 1) 600ms both;
    }
    @keyframes figure {
      0% {
        translate: 0 16px;
        opacity: 0;
        filter: blur(4px);
      }
      100% {
        translate: 0 0;
        opacity: 1;
        filter: blur(0);
      }
    }

    [data-part="scribble"] > :global(path) {
      transform-origin: top right;
      animation: scribble 1s cubic-bezier(0.645, 0.045, 0.355, 1) both;
    }
    @keyframes scribble {
      0% {
        stroke-dasharray: 1;
        stroke-dashoffset: -1;
        scale: 0.95;
      }
      100% {
        stroke-dasharray: 1;
        stroke-dashoffset: 0;
        scale: 1;
      }
    }
  }
</style>
