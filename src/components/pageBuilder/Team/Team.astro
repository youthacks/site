---
import type { Team } from "sanity.types";
import TeamGrid from "./TeamGrid.svelte";

interface Props {
  data: Team;
}
const { data } = Astro.props;

const bgColor = {
  red: "bg-red-200",
  yellow: "bg-yellow-200",
  blue: "bg-cyan-200",
  grey: "bg-neutral-100",
}[data.color || "red"];
---

<div class:list={[bgColor, "bg-noise"]}>
  <div class="mx-auto max-w-7xl p-8 md:p-12">
    <h2 class="font-heading text-3xl font-bold md:text-4xl">{data.title}</h2>
    <div class="mt-6">
      <TeamGrid members={data.members || []} color={data.color} client:load />
    </div>
  </div>
</div>
