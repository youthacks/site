---
import type { HomeMission } from "sanity.types";
import PortableText from "~/components/content/PortableText.astro";
import SanityImage from "~/components/SanityImage.astro";

interface Props {
  data: HomeMission;
}
const { data } = Astro.props;
---

<div class="mx-auto max-w-7xl overflow-clip p-8 pb-0! md:p-12">
  <h2 class="font-heading text-4xl font-bold">{data.title}</h2>
  <PortableText
    value={data.content || []}
    color={data.color}
    class="mt-4 space-y-4 text-xl text-neutral-900"
  />
  <div class="mt-8 flex max-md:flex-col">
    <div class="-mr-6 -mb-2 min-w-0 flex-auto basis-3/5 md:-mr-10">
      <div
        class="aspect-3/2 -rotate-2 border border-neutral-300 bg-white p-3 shadow-md"
      >
        <SanityImage
          src={data.images![0].asset!}
          width={740}
          widths={[360, 740]}
          sizes="(min-width: 1280px) 740px, (min-width: 768px) 60vw, 100vw"
          alt=""
          class="size-full object-cover"
        />
      </div>
    </div>
    <div
      class="-mt-12 -ml-6 min-w-0 flex-auto basis-2/5 max-md:-mb-16 md:-mt-6 md:-ml-10 md:contain-size lg:-mt-12"
    >
      <div
        class="aspect-3/2 rotate-2 border border-neutral-300 bg-white p-3 shadow-md md:-translate-x-12"
      >
        <SanityImage
          src={data.images![1].asset!}
          width={640}
          widths={[360, 640]}
          sizes="(min-width: 1280px) 640px, (min-width: 768px) 40vw, 100vw"
          alt=""
          class="size-full object-cover"
        />
      </div>
      <div
        class="-mt-16 aspect-3/2 -rotate-3 border border-neutral-300 bg-white p-3 shadow-md max-md:translate-x-8 md:-mt-12 lg:-mt-16"
      >
        <SanityImage
          src={data.images![2].asset!}
          width={640}
          widths={[360, 640]}
          sizes="(min-width: 1280px) 640px, (min-width: 768px) 40vw, 100vw"
          alt=""
          class="size-full object-cover"
        />
      </div>
    </div>
  </div>
</div>
