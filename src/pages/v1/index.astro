---
import Layout from "~/layouts/v1/Layout.astro";

import Navbar from "~/components/v1/navbar/Navbar.svelte";
import HomeHero from "~/components/v1/home/Hero.astro";
import Footer from "~/components/v1/Footer.astro";

import Upcoming from "~/components/v1/home/Upcoming.astro";
import Mission from "~/components/v1/home/Mission.astro";
import Impact from "~/components/v1/home/Impact.astro";
import Partners from "~/components/v1/home/Partners.astro";
---

<Layout pageTitle="We are makers | Hackathons for teens in the UK">
  <Navbar client:load />

  <HomeHero />

  <div class="divide-y divide-neutral-300 *:even:bg-neutral-50">
    <Upcoming />
    <Mission />
    <Impact />
    <Partners />
  </div>

  <Footer />
</Layout>
