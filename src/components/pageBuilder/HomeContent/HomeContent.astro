---
import type { HomeContent } from "sanity.types";
import PortableText from "~/components/content/PortableText.astro";

interface Props {
  data: HomeContent;
}
const { data } = Astro.props;
---

<div class="mx-auto max-w-7xl p-12" data-transparent>
  <h2 class="font-heading text-4xl font-bold">{data.title}</h2>
  <PortableText
    value={data.content || []}
    color={data.color}
    class="mt-4 space-y-4 text-xl text-neutral-900"
  />
</div>
