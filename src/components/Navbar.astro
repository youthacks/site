---
import { sanityClient } from "sanity:client";
import { LAYOUT_QUERY } from "~/queries";
import SanityImage from "./SanityImage.astro";
import resolveInternalLink from "~/lib/internalLink";

interface Props {
  color?: "black" | "white";
}
const { color = "black" } = Astro.props;

const result = await sanityClient.fetch(LAYOUT_QUERY);
---

<header id="header" class="group fixed inset-x-0 top-0 z-20">
  <div class="mx-auto max-w-7xl p-2">
    <div class="relative isolate flex h-18 items-center px-6">
      <div
        class="absolute inset-0 -z-10 scale-98 rounded-lg bg-white opacity-0 shadow-xl transition group-data-open:scale-100 group-data-open:opacity-100"
      >
      </div>
      {
        result?.navbar?.logo && (
          <a href="/">
            <SanityImage src={result.navbar.logo} class="h-8" />
          </a>
        )
      }
      <div class="flex-1"></div>
      <nav
        class:list={[
          "flex items-center gap-3",
          color === "white" &&
            "-mx-5 rounded-full bg-white px-5 py-2 transition-shadow not-group-data-open:shadow-xl",
        ]}
      >
        {
          (result?.navbar?.links || []).map(async (link, idx) => (
            <>
              {idx > 0 && <span class="text-current/50">/</span>}
              <a
                href={await resolveInternalLink(link.link)}
                class="text-lg font-semibold underline-offset-2 hover:underline"
              >
                {link.label}
              </a>
            </>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<script>
  function onScroll() {
    const header = document.getElementById("header");
    if (!header) return;

    if (window.scrollY > 32) {
      header.dataset.open = "true";
    } else {
      delete header.dataset.open;
    }
  }

  window.addEventListener("scroll", onScroll);
  onScroll();
</script>
