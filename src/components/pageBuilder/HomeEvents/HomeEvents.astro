---
import type { HomeEvents } from "sanity.types";

interface Props {
  data: HomeEvents;
}
const { data } = Astro.props;

const bgColor = {
  red: "bg-red-200",
  yellow: "bg-yellow-200",
  blue: "bg-cyan-200",
  grey: "bg-neutral-100",
}[data.color || "red"];

const textColor = {
  red: "text-red-800",
  yellow: "text-yellow-800",
  blue: "text-cyan-800",
  grey: "text-neutral-600",
}[data.color || "red"];
---

<div class={bgColor}>
  <div class="mx-auto max-w-7xl p-8">
    <div class="flex items-center gap-3">
      <div class:list={["size-7 rounded-full bg-current", textColor]}></div>
      <h2 class="font-heading text-4xl font-bold">{data.title}</h2>
    </div>
  </div>
</div>
