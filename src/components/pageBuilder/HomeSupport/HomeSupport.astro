---
import type { HomeSupport } from "sanity.types";
import { sanityClient } from "sanity:client";
import PortableText from "~/components/content/PortableText.astro";
import SanityImage from "~/components/SanityImage.astro";
import { SPONSORS_QUERY } from "~/queries";

interface Props {
  data: HomeSupport;
}
const { data } = Astro.props;

const sponsors = await sanityClient.fetch(SPONSORS_QUERY);
---

<div class="mx-auto max-w-7xl overflow-clip p-12 pb-0">
  <h2 class="font-heading text-4xl font-bold">{data.title}</h2>
  <PortableText
    value={data.content || []}
    color={data.color}
    class="mt-4 space-y-4 text-xl text-neutral-900"
  />
  <div
    class="mask-marquee group mt-6 flex overflow-hidden py-2"
    style={`--items: ${sponsors.length}`}
  >
    {
      Array.from({ length: 2 }).map((_, idx) => (
        <div
          class="animate-marquee pointer-events-none flex group-has-hover:[animation-play-state:paused]! group-has-focus:[animation-play-state:paused]!"
          {...(idx !== 0 ? { "aria-hidden": "true" } : {})}
        >
          {sponsors.map((sponsor) => (
            <a
              href={sponsor.url}
              title={sponsor.title}
              target="_blank"
              rel="noopener"
              class="pointer-events-auto w-max flex-none px-2 transition not-focus:not-hover:opacity-50 not-focus:not-hover:grayscale group-has-hover:not-hover:not-focus:opacity-25 group-has-focus:not-focus:not-hover:opacity-25 hover:scale-105 focus:scale-105"
              {...(idx !== 0 ? { tabIndex: -1 } : {})}
            >
              <SanityImage
                src={sponsor.image!.asset!}
                alt={sponsor.title}
                height={80}
                class="h-20"
              />
            </a>
          ))}
        </div>
      ))
    }
  </div>
  <div class="mt-8 flex">
    <div
      class="relative z-10 mt-6 -mr-6 min-w-0 flex-auto basis-1/2 contain-size"
    >
      <div
        class="aspect-3/2 rotate-2 border border-neutral-300 bg-white p-3 shadow-md"
      >
        <SanityImage
          src={data.images![0].asset!}
          width={640}
          widths={[360, 640]}
          sizes="(min-width: 1280px) 640px, 50vw"
          alt=""
        />
      </div>
    </div>
    <div class="-mb-6 -ml-6 min-w-0 flex-auto basis-1/2">
      <div
        class="aspect-3/2 -rotate-2 border border-neutral-300 bg-white p-3 shadow-md"
      >
        <SanityImage
          src={data.images![1].asset!}
          width={640}
          widths={[360, 640]}
          sizes="(min-width: 1280px) 640px, 50vw"
          alt=""
        />
      </div>
    </div>
  </div>
</div>

<style>
  .mask-marquee {
    mask-image: linear-gradient(
      to right,
      #0000 0,
      #000 6rem,
      #000 calc(100% - 6rem),
      #0000 100%
    );
  }
  .animate-marquee {
    animation: marquee calc(var(--items) * 5s) linear infinite;
  }
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }
</style>
